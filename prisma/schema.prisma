// TraceWorks Lab — firmware-level electronics repair
// Primary data model. PostgreSQL + Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OWNER
  MANAGER
  SALES
  TECHNICIAN
  FRONT_DESK
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum PriceAction {
  INCREASE
  DECREASE
  MAINTAIN
  REQUIRE_DIAGNOSTIC_FEE
  MANUAL_REVIEW
}

enum RecommendationStatus {
  PENDING_REVIEW
  AUTO_APPROVED
  APPROVED
  REJECTED
  EDITED
}

enum AgentName {
  ORCHESTRATOR
  COST_AGENT
  PRICING_AGENT
  MARKETING_ORCHESTRATOR
  MARKETING_GUARDIAN
  MARKETING_CREATIVE
}

enum RepairStatus {
  NEW
  UNDER_REVIEW
  DIAGNOSTIC_PENDING
  DIAGNOSING
  QUOTE_SENT
  APPROVED
  IN_REPAIR
  TESTING
  COMPLETED
  RETURN_SHIPPING
  CLOSED
  UNREPAIRABLE
}

enum ServicePreference {
  LOCAL_DROP_OFF
  MAIL_IN
  SHIP_IN
  BUSINESS_ACCOUNT
  FLEET_SERVICE_ACCOUNT
}

enum EquipmentCategory {
  PHONE_TABLET
  COMPUTER_MOTHERBOARD
  GPU
  GAME_CONSOLE
  AUTOMOTIVE_MODULE
  AVIATION_ELECTRONICS
  ASIC_MINING_HARDWARE
  INDUSTRIAL_SPECIALTY
  OTHER
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  EXPIRED
}

enum AttachmentKind {
  PHOTO
  VIDEO
  DOCUMENT
  DIAGNOSTIC_REPORT
}

enum MessageSender {
  CUSTOMER
  TECHNICIAN
  SYSTEM
}

enum ContactSubmissionType {
  GENERAL
  BUSINESS_ACCOUNT
  REPAIR_SHOP_PARTNER
  MEDIA
}

// ---------------------------------------------------------------------------
// Identity & accounts
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(TECHNICIAN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  technician Technician?
  auditLogs  AuditLog[]

  updatedPricingRules     PricingRule[]           @relation("PricingRuleUpdatedBy")
  reviewedRecommendations PricingRecommendation[] @relation("RecommendationReviewedBy")
  updatedSystemSettings   SystemSetting[]         @relation("SystemSettingUpdatedBy")
  reviewedMarketingDrafts MarketingDraft[]        @relation("MarketingDraftReviewedBy")

  @@index([email])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Mailing address — required for mail-in/ship-in service so a repaired
  // device or board has somewhere to be shipped back to; also serves as a
  // basic identity-verification signal for trade/fraud review.
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  zip          String?

  businessAccount   BusinessAccount? @relation(fields: [businessAccountId], references: [id])
  businessAccountId String?

  repairRequests Repair[]
  messages       Message[]

  @@index([email])
  @@index([businessAccountId])
}

model BusinessAccount {
  id               String   @id @default(cuid())
  shopName         String
  contactName      String
  email            String   @unique
  phone            String?
  website          String?
  monthlyVolume    String?
  equipmentTypes   String?
  outsourcingNeeds String?
  accountType      String   @default("trade") // trade | fleet | insurance | refurbisher
  isApproved       Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customers Customer[]

  @@index([email])
}

model Technician {
  id                   String   @id @default(cuid())
  user                 User     @relation(fields: [userId], references: [id])
  userId               String   @unique
  title                String?
  bio                  String?
  isActive             Boolean  @default(true)
  hourlyCostCents      Int?
  capacityHoursPerWeek Float?
  createdAt            DateTime @default(now())

  repairs Repair[]
}

// ---------------------------------------------------------------------------
// Service catalog (content lives primarily in the static content layer;
// these tables let admins override/extend catalog data and back the
// searchable service directory + future CMS editing).
// ---------------------------------------------------------------------------

model ServiceCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]
}

model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  shortSummary    String
  metaTitle       String?
  metaDescription String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category   ServiceCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  @@index([categoryId])
}

model Location {
  id        String   @id @default(cuid())
  slug      String   @unique
  city      String
  state     String   @default("TX")
  zipCodes  String[]
  headline  String
  summary   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Repair workflow
// ---------------------------------------------------------------------------

model Device {
  id           String            @id @default(cuid())
  category     EquipmentCategory
  manufacturer String
  model        String
  serialNumber String?
  partNumber   String?
  createdAt    DateTime          @default(now())

  repair Repair?
}

model Repair {
  id                String            @id @default(cuid())
  referenceCode     String            @unique
  status            RepairStatus      @default(NEW)
  servicePreference ServicePreference

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  device   Device @relation(fields: [deviceId], references: [id])
  deviceId String @unique

  errorCode         String?
  symptoms          String
  problemStartedAt  String?
  previousAttempts  String?
  hasLiquidDamage   Boolean @default(false)
  hasPhysicalDamage Boolean @default(false)
  hasPowerIssue     Boolean @default(false)
  isIntermittent    Boolean @default(false)
  hasNoDisplay      Boolean @default(false)
  hasBootFailure    Boolean @default(false)

  assignedTechnician Technician? @relation(fields: [technicianId], references: [id])
  technicianId       String?

  repairCategory           RepairCategory? @relation(fields: [repairCategoryId], references: [id])
  repairCategoryId         String?
  estimatedTechnicianHours Float?

  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  diagnostics            Diagnostic[]
  quotes                 Quote[]
  attachments            Attachment[]
  messages               Message[]
  statusHistory          RepairStatusEvent[]
  pricingRecommendations PricingRecommendation[]

  @@index([customerId])
  @@index([status])
  @@index([referenceCode])
  @@index([repairCategoryId])
}

model RepairStatusEvent {
  id        String       @id @default(cuid())
  repair    Repair       @relation(fields: [repairId], references: [id])
  repairId  String
  status    RepairStatus
  note      String?
  createdAt DateTime     @default(now())

  @@index([repairId])
}

model Diagnostic {
  id           String   @id @default(cuid())
  repair       Repair   @relation(fields: [repairId], references: [id])
  repairId     String
  findings     String
  rootCause    String?
  isRepairable Boolean?
  performedBy  String?
  createdAt    DateTime @default(now())

  @@index([repairId])
}

model Quote {
  id          String      @id @default(cuid())
  repair      Repair      @relation(fields: [repairId], references: [id])
  repairId    String
  amountCents Int?
  currency    String      @default("USD")
  status      QuoteStatus @default(DRAFT)
  notes       String?
  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([repairId])
}

model Attachment {
  id         String         @id @default(cuid())
  repair     Repair         @relation(fields: [repairId], references: [id])
  repairId   String
  kind       AttachmentKind
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int
  uploadedBy String?
  createdAt  DateTime       @default(now())

  @@index([repairId])
}

model Message {
  id         String        @id @default(cuid())
  repair     Repair        @relation(fields: [repairId], references: [id])
  repairId   String
  customer   Customer?     @relation(fields: [customerId], references: [id])
  customerId String?
  sender     MessageSender
  body       String
  createdAt  DateTime      @default(now())

  @@index([repairId])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model FAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String
  body            String
  category        String
  authorName      String?
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  authorName  String
  authorRole  String?
  quote       String
  serviceSlug String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ContactSubmission {
  id        String                @id @default(cuid())
  type      ContactSubmissionType @default(GENERAL)
  name      String
  email     String
  phone     String?
  message   String
  metadata  Json?
  createdAt DateTime              @default(now())

  @@index([type])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id])
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// Revenue / Pricing / Profit Optimization platform
// See /docs/DATABASE_ARCHITECTURE.md, /docs/PRICING_ENGINE.md,
// /docs/AGENT_SPECIFICATIONS.md for the full design rationale.
// ---------------------------------------------------------------------------

model RepairCategory {
  id                     String    @id @default(cuid())
  slug                   String    @unique
  name                   String
  description            String?
  riskLevel              RiskLevel @default(MEDIUM)
  defaultLaborHours      Float
  defaultDiagnosticHours Float     @default(0.5)
  defaultPartsCostCents  Int       @default(0)
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  repairs         Repair[]
  recommendations PricingRecommendation[]

  @@index([slug])
  @@index([isActive])
}

model PricingRule {
  id                           String   @id @default(cuid())
  key                          String   @unique @default("global")
  minimumMarginPercent         Float    @default(0.35)
  targetMarginPercent          Float    @default(0.55)
  minimumDiagnosticFeeCents    Int      @default(4900)
  minimumRepairPriceCents      Int      @default(4900)
  maximumDiscountPercent       Float    @default(0.15)
  rushMultiplier               Float    @default(1.25)
  complexityMultiplierMax      Float    @default(1.30)
  riskMultiplierMax            Float    @default(1.20)
  premiumFactor                Float    @default(1.15)
  maximumJustifiedMultiplier   Float    @default(1.6)
  warrantyReservePercent       Float    @default(0.04)
  overheadAllocationPercent    Float    @default(0.08)
  paymentProcessingPercent     Float    @default(0.029)
  paymentProcessingFixedCents  Int      @default(30)
  technicianHourlyCostCents    Int      @default(4500)
  capacityHighThresholdPercent Float    @default(0.90)
  capacityLowThresholdPercent  Float    @default(0.50)
  approvalConfidenceThreshold  Float    @default(0.55)
  manualReviewOverride         Boolean  @default(false)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  updatedBy                    User?    @relation("PricingRuleUpdatedBy", fields: [updatedById], references: [id])
  updatedById                  String?

  @@index([key])
}

model PricingRecommendation {
  id               String          @id @default(cuid())
  repairCategory   RepairCategory? @relation(fields: [repairCategoryId], references: [id])
  repairCategoryId String?
  repair           Repair?         @relation(fields: [repairId], references: [id])
  repairId         String?

  partsCostCents            Int
  laborHours                Float
  technicianHourlyCostCents Int
  shippingCostCents         Int
  paymentCostCents          Int
  consumablesCostCents      Int
  warrantyReserveCents      Int
  overheadCents             Int
  estimatedTotalCostCents   Int

  priceFloorCents        Int
  competitivePriceCents  Int?
  recommendedPriceCents  Int
  premiumPriceCents      Int
  maxJustifiedPriceCents Int

  grossProfitCents                Int
  grossMarginPercent              Float
  profitPerTechnicianHourCents    Int?
  estimatedAcceptanceProbability  Float
  expectedContributionProfitCents Int
  confidence                      Float

  priceAction           PriceAction
  reasoning             String[]
  riskFlags             String[]
  requiresHumanApproval Boolean

  status          RecommendationStatus @default(PENDING_REVIEW)
  finalPriceCents Int?
  reviewedBy      User?                @relation("RecommendationReviewedBy", fields: [reviewedById], references: [id])
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?

  createdAt DateTime @default(now())

  agentRuns AgentRun[]

  @@index([repairCategoryId])
  @@index([repairId])
  @@index([status])
  @@index([createdAt])
}

model AgentRun {
  id                String    @id @default(cuid())
  agentName         AgentName
  taskDescription   String
  provider          String
  model             String?
  inputSummary      Json
  outputSummary     Json
  confidence        Float?
  latencyMs         Int
  tokenEstimate     Int?
  costEstimateCents Int?
  succeeded         Boolean
  errorMessage      String?
  createdAt         DateTime  @default(now())

  pricingRecommendation   PricingRecommendation? @relation(fields: [pricingRecommendationId], references: [id])
  pricingRecommendationId String?

  @@index([agentName])
  @@index([pricingRecommendationId])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("SystemSettingUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?
}

// --- Marketing AI Agent Swarm ------------------------------------------
// See /docs/MARKETING_AI_ARCHITECTURE.md. Same design rules as the pricing
// agent layer: agents never spend money or publish content directly — every
// proposed action is a MarketingDraft a human must approve — and every
// self-learning claim is stored with its evidence and a confidence label,
// never as an unsourced assertion.

enum MarketingChannel {
  GOOGLE_SEARCH
  GOOGLE_LSA
  META
  TIKTOK
  YOUTUBE
  EMAIL
  ORGANIC_SITE
}

enum MarketingDraftType {
  CAMPAIGN_LAUNCH
  BUDGET_CHANGE
  AD_CREATIVE
  SOCIAL_POST
  EMAIL_SEND
}

enum MarketingDraftStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum GuardrailAction {
  WATCH
  FLAG_FOR_REVIEW
  AUTO_PAUSE
  AUTO_REALLOCATE
}

// A proposed marketing action awaiting human approval. Nothing in this
// codebase executes a MarketingDraft automatically — see
// evaluateCampaignHealth()/evaluateFunnelHealth() in src/lib/marketing/
// guardrails.ts for why "auto-pause" today means "drafted for approval",
// not "executed", until a live ad-platform integration exists.
model MarketingDraft {
  id             String                @id @default(cuid())
  type           MarketingDraftType
  channel        MarketingChannel
  title          String
  payload        Json
  rationale      String?
  guardrailAction GuardrailAction?
  status         MarketingDraftStatus  @default(PENDING_REVIEW)
  createdByAgent AgentName
  sourceAgentRunId String?

  reviewedBy   User?     @relation("MarketingDraftReviewedBy", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([channel])
  @@index([type])
  @@index([createdAt])
}

// The self-learning memory: a claim about what works, always tied to the
// evidence it came from and labeled with a confidence tier (mirrors the
// "known_fact"/"historical_evidence"/"hypothesis"/"insufficient_data"
// convention from pricing-agent.ts). Read by the creative agent before it
// drafts new copy; written by the guardian/orchestrator after a cycle.
model MarketingLesson {
  id             String           @id @default(cuid())
  channel        MarketingChannel
  tag            String
  summary        String
  evidence       Json
  confidence     String
  sourceDraftId  String?
  createdAt      DateTime         @default(now())

  @@index([channel])
  @@index([tag])
  @@index([createdAt])
}

enum FunnelCheckStatus {
  OK
  DEGRADED
  DOWN
}

// Self-healing (technical): a health-check result for a public funnel
// (a page, an API route, the sitemap). Written by scripts/marketing-swarm/
// funnel-health-check.mjs via POST /api/admin/funnel-checks, typically on a
// schedule (see .github/workflows/funnel-health-check.yml).
model FunnelCheck {
  id          String            @id @default(cuid())
  target      String
  url         String
  status      FunnelCheckStatus
  httpStatus  Int?
  latencyMs   Int?
  errorDetail String?
  checkedAt   DateTime          @default(now())

  @@index([target])
  @@index([status])
  @@index([checkedAt])
}

// One row per Bird mailbox conversation thread we've acknowledged. The
// unique constraint on threadId is the loop-prevention mechanism for the
// inbound-email auto-responder (POST /api/webhooks/bird): a thread gets at
// most one automated acknowledgment, no matter how many follow-up messages
// arrive on it or how many times Bird retries the webhook delivery.
model InboundEmailAck {
  id          String   @id @default(cuid())
  threadId    String   @unique
  mailboxId   String
  messageId   String
  fromAddress String
  subject     String?
  repliedAt   DateTime @default(now())

  @@index([mailboxId])
  @@index([fromAddress, repliedAt])
}
