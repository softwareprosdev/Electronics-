# Database (PostgreSQL)
DATABASE_URL="postgresql://electronics:electronics@localhost:5432/electronics_repair?schema=public"

# Public site
NEXT_PUBLIC_SITE_URL="https://www.example-electronics-lab.com"
NEXT_PUBLIC_BUSINESS_PHONE="+19561234567"
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY="(956) 123-4567"
NEXT_PUBLIC_BUSINESS_EMAIL="repairs@example-electronics-lab.com"

# Admin session
ADMIN_SESSION_SECRET="replace-with-a-long-random-string-min-32-chars"
ADMIN_EMAIL="admin@example-electronics-lab.com"
ADMIN_PASSWORD_HASH="replace-with-bcrypt-hash"

# Object storage (S3-compatible) for private repair attachments
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Email provider (abstracted — plug in Resend/SES/Postmark/etc.)
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="Repair Lab <no-reply@example-electronics-lab.com>"

# SMS provider (abstracted — plug in Twilio/etc.)
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_FROM=""

# Maps provider (abstracted)
MAPS_PROVIDER="none"
MAPS_API_KEY=""

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Rate limiting (optional Upstash Redis; falls back to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
