# Database (PostgreSQL)
DATABASE_URL="postgresql://electronics:electronics@localhost:5432/electronics_repair?schema=public"

# Public site
NEXT_PUBLIC_SITE_URL="https://www.example-electronics-lab.com"
NEXT_PUBLIC_BUSINESS_PHONE="+19563921440"
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY="(956) 392-1440"
NEXT_PUBLIC_BUSINESS_EMAIL="info@traceworkslab.com"

# Internal notification destination for new repair requests specifically
# (contact form / business account submissions go to NEXT_PUBLIC_BUSINESS_EMAIL above).
# Both are superseded by INTERNAL_NOTIFY_EMAIL below when it's set.
REPAIR_NOTIFY_EMAIL="repairs@traceworkslab.com"

# Where "you have a new lead" emails actually get sent — set this to an
# inbox you actually check (not a site-hosted mailbox) so new leads/repair
# requests/contact submissions don't go unnoticed. Overrides both
# NEXT_PUBLIC_BUSINESS_EMAIL and REPAIR_NOTIFY_EMAIL as the notification
# target; the public-facing addresses above are unaffected.
INTERNAL_NOTIFY_EMAIL="softwareproscompany@gmail.com"

# Admin session
ADMIN_SESSION_SECRET="replace-with-a-long-random-string-min-32-chars"
ADMIN_EMAIL="admin@example-electronics-lab.com"
ADMIN_PASSWORD_HASH="replace-with-argon2id-hash"

# Object storage (S3-compatible) for private repair attachments
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Email provider (abstracted — "console" logs only, "bird" sends for real).
# EMAIL_API_KEY is your Bird API key (bk_xxxxxxxxx).
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="TraceWorks Lab <onboarding@messagebird.dev>"

# Bird Mailbox ID (mbx_xxxxxxxxx) for composeFromMailbox() in
# src/lib/mailbox.ts, used to send as a specific Bird-managed mailbox
# rather than a generic sender. Reuses EMAIL_API_KEY above.
BIRD_MAILBOX_ID=""

# Signing secret (whsec_xxxxxxxxx) for the Bird webhook subscribed to
# email_mailbox.message_received, used by POST /api/webhooks/bird to send an
# instant acknowledgment reply to inbound customer email. Create the webhook
# endpoint in Bird's dashboard pointing to
# https://www.traceworkslab.com/api/webhooks/bird — the signing secret is
# shown only once, at creation time.
BIRD_WEBHOOK_SECRET=""

# Payment provider (abstracted, see src/lib/payments.ts — only "stripe" is
# implemented today). Used to generate a Stripe Checkout payment link for an
# invoice's balance due (POST /api/admin/invoices/[id]/checkout).
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY=""
# Signing secret (whsec_xxxxxxxxx) for the Stripe webhook subscribed to
# checkout.session.completed, used by POST /api/webhooks/stripe to record
# the payment automatically once a customer pays. Create the webhook
# endpoint in the Stripe dashboard pointing to
# https://www.traceworkslab.com/api/webhooks/stripe — the signing secret is
# shown only once, at creation time.
STRIPE_WEBHOOK_SECRET=""

# SMS provider (abstracted — plug in Twilio/etc.)
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_FROM=""

# Maps provider (abstracted)
MAPS_PROVIDER="none"
MAPS_API_KEY=""

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Self-hosted Umami (analytics.traceworkslab.com). Get the website ID from
# Umami: Settings -> Websites -> traceworkslab.com -> Edit (or Tracking Code).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# Google Ads conversion tracking (AW-XXXXXXXXX). From Google Ads: Tools &
# Settings -> Conversions -> your conversion action -> tag setup. Shares the
# gtag.js loader with NEXT_PUBLIC_GA_MEASUREMENT_ID above.
NEXT_PUBLIC_GOOGLE_ADS_ID=""

# Meta Pixel (Facebook/Instagram Ads). From Meta Events Manager: Data
# Sources -> your pixel -> Settings -> Pixel ID.
NEXT_PUBLIC_META_PIXEL_ID=""

# Rate limiting (optional Upstash Redis; falls back to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# AI provider for the pricing/revenue platform (see /docs/REVENUE_AI_ARCHITECTURE.md).
# Leave AI_PROVIDER unset and ANTHROPIC_API_KEY empty to run with no AI provider —
# the deterministic pricing engine still works fully; the AI layer only adds a
# narrative explanation and symptom risk-flag classification on top.
AI_PROVIDER=""
ANTHROPIC_API_KEY=""
AI_MODEL_FAST="claude-haiku-4-5-20251001"
AI_MODEL_ADVANCED="claude-sonnet-5"

# Marketing agent swarm (see /docs/MARKETING_AI_ARCHITECTURE.md). Shared
# secret the scheduled funnel-health-check script authenticates with —
# generate a long random string and set the same value as a GitHub Actions
# repo secret named FUNNEL_CHECK_SECRET.
FUNNEL_CHECK_SECRET=""

# Shared secret for a scheduled automation (e.g. n8n) to trigger the
# creative agent (POST /api/admin/marketing-drafts) without an admin
# session — same pattern as FUNNEL_CHECK_SECRET above.
MARKETING_AGENT_SECRET=""
