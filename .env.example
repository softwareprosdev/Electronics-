# Database (PostgreSQL)
DATABASE_URL="postgresql://electronics:electronics@localhost:5432/electronics_repair?schema=public"

# Public site
NEXT_PUBLIC_SITE_URL="https://www.example-electronics-lab.com"
NEXT_PUBLIC_BUSINESS_PHONE="+19563921440"
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY="(956) 392-1440"
NEXT_PUBLIC_BUSINESS_EMAIL="info@traceworkslab.com"

# Internal notification destination for new repair requests specifically
# (contact form / business account submissions go to NEXT_PUBLIC_BUSINESS_EMAIL above).
REPAIR_NOTIFY_EMAIL="repairs@traceworkslab.com"

# Admin session
ADMIN_SESSION_SECRET="replace-with-a-long-random-string-min-32-chars"
ADMIN_EMAIL="admin@example-electronics-lab.com"
ADMIN_PASSWORD_HASH="replace-with-bcrypt-hash"

# Object storage (S3-compatible) for private repair attachments
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Email provider (abstracted — "console" logs only, "resend" sends for real)
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="TraceWorks Lab <onboarding@resend.dev>"

# SMS provider (abstracted — plug in Twilio/etc.)
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_FROM=""

# Maps provider (abstracted)
MAPS_PROVIDER="none"
MAPS_API_KEY=""

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Rate limiting (optional Upstash Redis; falls back to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# AI provider for the pricing/revenue platform (see /docs/REVENUE_AI_ARCHITECTURE.md).
# Leave AI_PROVIDER unset and ANTHROPIC_API_KEY empty to run with no AI provider —
# the deterministic pricing engine still works fully; the AI layer only adds a
# narrative explanation and symptom risk-flag classification on top.
AI_PROVIDER=""
ANTHROPIC_API_KEY=""
AI_MODEL_FAST="claude-haiku-4-5-20251001"
AI_MODEL_ADVANCED="claude-sonnet-5"

# Marketing agent swarm (see /docs/MARKETING_AI_ARCHITECTURE.md). Shared
# secret the scheduled funnel-health-check script authenticates with —
# generate a long random string and set the same value as a GitHub Actions
# repo secret named FUNNEL_CHECK_SECRET.
FUNNEL_CHECK_SECRET=""

# Shared secret for a scheduled automation (e.g. n8n) to trigger the
# creative agent (POST /api/admin/marketing-drafts) without an admin
# session — same pattern as FUNNEL_CHECK_SECRET above.
MARKETING_AGENT_SECRET=""
